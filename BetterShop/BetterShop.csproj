<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net35</TargetFramework>
        <AssemblyName>BetterShop</AssemblyName>
        <RootNamespace>BetterShop</RootNamespace>
        <LangVersion>8.0</LangVersion>
        <OutputType>Library</OutputType>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    </ItemGroup>

    <PropertyGroup>
        <GameDir>D:\EnterTheGungeon</GameDir>
        <BepInExDir>C:\Users\jfy\AppData\Roaming\Thunderstore Mod Manager\DataFolder\ETG\profiles\Default\BepInEx</BepInExDir>
        <ManagedDir>$(GameDir)\EtG_Data\Managed</ManagedDir>
    </PropertyGroup>

    <!-- BepInEx 核心引用 -->
    <ItemGroup>
        <Reference Include="BepInEx">
            <HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="0Harmony">
            <HintPath>$(BepInExDir)\core\0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <!-- Unity 引擎引用 -->
    <ItemGroup>
        <Reference Include="UnityEngine">
            <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <!-- Alexandria API 引用 -->
    <ItemGroup>
        <Reference Include="Alexandria">
            <HintPath>$(BepInExDir)\plugins\Alexandria-Alexandria\Alexandria.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>


    <!-- 游戏程序集引用 -->
    <ItemGroup>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <!-- 构建后自动复制到 BepInEx 插件目录（方便测试） -->
    <Target Name="CopyToPlugins" AfterTargets="Build">
        <Copy SourceFiles="$(OutputPath)\$(AssemblyName).dll" DestinationFolder="$(BepInExDir)\plugins\BetterShop\" SkipUnchangedFiles="true" />
    </Target>

</Project>
